{
  "name": "oqtosh-kassa",
  "productName": "Oqtosh Kassa",
  "version": "2.1.0",
  "description": "Oqtosh restoran: kassa, ofitsiant, admin panel, owner hisobotlari, printerlar va server — bitta dasturda",
  "main": "main.js",
  "author": "Oqtosh Restoran",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/agent-smoke.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uz.oqtoshrestoran.desktop",
    "productName": "Oqtosh Kassa",
    "copyright": "Oqtosh Restoran",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server-host.js",
      "config.json",
      "package.json",
      "agent/**",
      "app/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Oqtosh-Kassa-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Oqtosh Kassa",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/test/**"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "cloudflared.exe"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
